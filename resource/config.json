            "maxAreaColor": "rgba(160, 0, 160, 0.6)",
            "sparseAreaColor": "rgba(120, 120, 0, 0.6)",
            "nanAreaColor": "rgba(120, 120, 120, 0.6)",
            "laneLabelBackgroundColor": {
                "light": "rgba(255, 255, 255, 0.75)",
                "dark": "rgba(0, 0, 0, 0.75)"
            },
            "primaryTickColor": "#DD0000",
            "elementaryTickColor": {
                "light": "green",
                "dark": "#44FF44"
            },
            "standardTickColor": {
                "light": "blue",
                "dark": "#8888FF"
            },
            "tick": {
                "mini": {
                    "length": 5,
                    "width": 1,
                    "color": {
                        "light": "#000000",
                        "dark": "#FFFFFF"
