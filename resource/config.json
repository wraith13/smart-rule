                "short": {
                    "length": 10,
                    "width": 1,
                    "color": {
                        "light": "#000000",
                        "dark": "#FFFFFF"
                    }
                },
                "medium": {
                    "length": 15,
                    "width": 1,
                    "color": {
                        "light": "#000000",
                        "dark": "#FFFFFF"
                    }
                },
                "long": {
                    "length": 20,
                    "width": 2,
                    "color": {
                        "light": "#000000",
                        "dark": "#FFFFFF"
                    }
                }
            },
            "tickLabel": {
                "fontFamily": "Arial, sans-serif",
                "fontSize": 12,
                "fontColor": {
                    "light": "#000000",
                    "dark": "#FFFFFF"
