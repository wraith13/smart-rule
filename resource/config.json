            "tickDensityThreshold_E243": 0.03,
            "tickDensityThreshold_E81": 0.1,
            "tickDensityThreshold_E27": 0.4,
            "tickDensityThreshold_E9": 1.5,
            "tickDensityThreshold_E3": 5,
            "tickDensityThreshold_5": 15,
            "tickDensityThreshold_10": 35
        }
