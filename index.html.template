<div id="view-list">
    <div id="ruler-view" class="view">
        RULER VIEW
        <svg id="ruler-svg" class="screen"></svg>
        <div id="ruler-new-slide-panel">
            <h2>Add a Lane:<h2>
            <button id="add-slide-button">add slide ➡️</button>
            <button id="add-inverted-slide-button">add inverted slide ➡️</button>
            <!-- button id="add-lane-button">⬅️ add lane</button -->
            <h3>Digit:<h3>
            <button id="add-si-digit-lane-button">⬅️ add si prefix lane</button>
            <button id="add-en-digit-lane-button">⬅️ add en digit lane</button>
            <button id="add-ja-digit-lane-button">⬅️ add ja digit lane</button>
            <h3>Math-basics:<h3>
            <button id="add-squared-lane-button">⬅️ add squared lane</button>
            <button id="add-cubed-lane-button">⬅️ add cubed lane</button>
            <button id="add-square-root-lane-button">⬅️ add square root lane</button>
            <button id="add-cube-root-lane-button">⬅️ add cube root lane</button>
            <button id="add-exponential-lane-button">⬅️ add exponential lane</button>
            <button id="add-exponential2-lane-button">⬅️ add exponential2 lane</button>
            <button id="add-exponential10-lane-button">⬅️ add exponential10 lane</button>
            <button id="add-logarithmic-lane-button">⬅️ add logarithmic lane</button>
            <button id="add-logarithmic2-lane-button">⬅️ add logarithmic2 lane</button>
            <button id="add-logarithmic10-lane-button">⬅️ add logarithmic10 lane</button>
            <h3>Math-trigonometric-functions:<h3>
            <button id="add-sine-lane-button">⬅️ add sine lane</button>
            <button id="add-cosine-lane-button">⬅️ add cosine lane</button>
            <button id="add-tangent-lane-button">⬅️ add tangent lane</button>
            <button id="add-secant-lane-button">⬅️ add secant lane</button>
            <button id="add-cosecant-lane-button">⬅️ add cosecant lane</button>
            <button id="add-cotangent-lane-button">⬅️ add cotangent lane</button>
            <button id="add-arcsine-lane-button">⬅️ add arcsine lane</button>
            <button id="add-arccosine-lane-button">⬅️ add arccosine lane</button>
            <button id="add-arctangent-lane-button">⬅️ add arctangent lane</button>
            <button id="add-arcsecant-lane-button">⬅️ add arcsecant lane</button>
            <button id="add-arccosecant-lane-button">⬅️ add arccosecant lane</button>
            <button id="add-arccotangent-lane-button">⬅️ add arccotangent lane</button>
            <h3>Math-numbers:<h3>
            <button id="add-prime-numbers-lane-button">⬅️ add prime numbers lane</button>
            <button id="add-prime-decomposition-lane-button">⬅️ add prime decomposition lane</button>
            <h3>Datasets:<h3>
            <button id="add-size-lane-button">⬅️ add size lane</button>
            <button id="add-area-lane-button">⬅️ add area lane</button>
            <button id="add-volume-lane-button">⬅️ add volume lane</button>
            <button id="add-mass-lane-button">⬅️ add mass lane</button>
            <button id="add-time-lane-button">⬅️ add time lane</button>
            <button id="add-speed-lane-button">⬅️ add speed lane</button>
            <button id="add-energy-lane-button">⬅️ add energy lane</button>
            <button id="add-temperature-lane-button">⬅️ add temperature lane</button>
            <button id="add-counting-lane-button">⬅️ add counting lane</button>
            <button id="add-sound-frequency-lane-button">⬅️ add sound frequency lane</button>
            <button id="add-emw-wavelength-lane-button">⬅️ add EMW wavelength lane</button>
            <button id="add-emw-frequency-lane-button">⬅️ add EMW frequency lane</button>
            <button id="add-emw-energy-lane-button">⬅️ add EMW energy lane</button>
            <button id="add-history-lane-button">⬅️ add history lane</button>
        </div>
        <div id="ruler-help-panel">
            <h2><span data-lang-key="Save"></span><span data-lang-key="lang-colon-suffix"></span></h2>
            <label>
                <input type="checkbox" id="include-cursor-checkbox" checked />
                <span data-lang-key="Include cursor"></span>
            </label>
            <button id="save-svg-image-button"><span data-lang-key="Save as SVG image"></span></button>
            <button id="save-png-image-button"><span data-lang-key="Save as PNG image"></span></button>
            <button id="copy-as-url-button"><span data-lang-key="Copy as URL"></span></button>
            <h2><span data-lang-key="Settings"></span><span data-lang-key="lang-colon-suffix"></span></h2>
            <label aria-labelledby="language-select-label-span">
                <span id="language-select-label-span" data-lang-key="Language"></span><span data-lang-key="lang-colon-suffix"></span>
                <select id="language-select"></select>
            </label>
            <label>
                <span data-lang-key="Theme"></span><span data-lang-key="lang-colon-suffix"></span>
                <select id="theme-select">
                    <option value="light">light</option>
                    <option value="dark">dark</option>
                    <option value="auto" selected>auto</option>
                </select>
            </label>
            <h3><span data-lang-key="Number format"></span><span data-lang-key="lang-colon-suffix"></span></h3>
            <label><span data-lang-key="Thousands separator"></span><span data-lang-key="lang-colon-suffix"></span>
                <select id="three-digit-separator-select">
                    <option value="none">none</option>
                    <option value="custom">custom</option>
                    <option value="thin-space" selected>thin-space</option>
                </select>
            </label>
            <label><span data-lang-key="Exponential notation"></span><span data-lang-key="lang-colon-suffix"></span>
                <select id="exponent-format-select">
                    <option value="e">E</option>
                    <option value="x10" selected>x10</option>
                </select>
            </label>
            <label>
                <span data-lang-key="Adjust exponent to multiple of 3"></span><span data-lang-key="lang-colon-suffix"></span>
                <input type="checkbox" id="exponent-multiple-of-three-checkbox" />
            </label>
            <label><span>数字</span><span data-lang-key="lang-colon-suffix"></span>
                <select id="number-format-select">
                    <option value="scientific" selected>scientific</option>
                    <option value="localized">localized</option>
                </select>
            </label>
            <label>
                <span data-lang-key="Approximate symbol"></span><span data-lang-key="lang-colon-suffix"></span>
                <select id="approximate-symbol-select">
                    <option value="tilde" selected>~</option>
                    <option value="asymptotic">≃</option>
                    <option value="approximately-equal">≈</option>
                    <option value="almost-equal">≅</option>
                </select>
            </label>
            <label>
                <span data-lang-key="Range symbol"></span><span data-lang-key="lang-colon-suffix"></span>
                <select id="range-symbol-select">
                    <option value="en-dash">–</option>
                    <option value="ellipsis" selected>⋯</option>
                    <option value="wave-dash">〜</option>
                    <option value="word">to</option>
                </select>
            </label>
            <label>
                <span data-lang-key="Or symbol"></span><span data-lang-key="lang-colon-suffix"></span>
                <select id="or-symbol-select">
                    <option value="union" selected>∪</option>
                    <option value="ascii">|</option>
                    <option value="word">or</option>
                </select>
            </label>
            <span>※この設定は一部のロケールでのみ機能します。</span>
            <h2><span data-lang-key="Help">Help</span><span data-lang-key="lang-colon-suffix"></span></h2>
            <ul>
                <li><a href="__REPOSITORY_URL__" target="_blank" rel="noopener noreferrer"><span data-lang-key="GitHub repository"></span></a></li>
        </div>
        <svg id="ruler-overlay-svg" class="screen" pointer-events="none"></svg>
    </div>
    <div id="grid-view" class="view">GRID VIEW</div>
    <div id="graph-view" class="view">GRAPH VIEW</div>
</div>
<div id="control-panel">
    <form aria-label="Control Panel">
        <button id="view-mode-button" class="round-button round-bar">
            <span id="ruler-view-icon">__RULER_ICON__</span>
            <span id="grid-view-icon">__GRID_ICON__</span>
            <span id="graph-view-icon">__GRAPH_ICON__</span>
        </button>
        <button id="view-scale-button" class="round-button round-bar">__ZOOM_ICON__</button>
        <button id="view-lock-button" class="round-button round-bar">__LOCKED_ICON__</button>
        <button id="fullscreen-button" class="round-button round-bar">__FULLSCREEN_ICON__</button>
    </form>
</div>
